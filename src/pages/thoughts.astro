---
const pageTitle = "The Thoughts — Sungwon Lee";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap">
  </head>
  <body>
    <header class="site-header">
      <div class="logo"><a href="/">Sungwon Lee</a></div>
      <nav class="main-nav">
        <a href="/pieces">The Pieces</a>
        <a href="/thoughts">The Thoughts</a>
        <a href="/interests">The Interests</a>
      </nav>
    </header>

    <main class="page-container">
      <h1>The Thoughts</h1>
      <p class="subtitle">A personal journal documenting life, reflections, and creative processes.</p>

      <div class="journal-accordion">
        <details class="journal-entry">
          <summary class="journal-summary">
            <span class="entry-date">January 30, 2026</span>
            <span class="entry-title">My Processing Process</span>
          </summary>
          <div class="journal-content">
            <p>Reflections on navigating creative work, daily routines, and personal growth...</p>
          </div>
        </details>

        <details class="journal-entry">
          <summary class="journal-summary">
            <span class="entry-date">January 10, 2026</span>
            <span class="entry-title">Family & Moving Out</span>
          </summary>
          <div class="journal-content">
            <p>Thoughts on relationships with parents and establishing independence...</p>
          </div>
        </details>
      </div>
    </main>

    <style>
      body { background-color: #f7f6f2; color: #1a1a1a; font-family: 'Plus Jakarta Sans', sans-serif; padding: 2rem 3rem; margin: 0; }
      .site-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 2rem; border-bottom: 1px solid #e2e0d8; }
      .logo a { font-weight: 700; text-decoration: none; color: #1a1a1a; }
      .main-nav a { margin-left: 2rem; text-decoration: none; color: #666; font-size: 0.95rem; }
      .page-container { max-width: 800px; margin: 3rem auto; }
      h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
      .subtitle { font-family: 'Playfair Display', serif; font-style: italic; color: #666; font-size: 1.2rem; margin-bottom: 3rem; }
      .journal-accordion { display: flex; flex-direction: column; gap: 1rem; }
      .journal-entry { background: #ffffff; border: 1px solid #e2e0d8; border-radius: 6px; padding: 1.25rem 1.5rem; }
      .journal-summary { cursor: pointer; font-weight: 600; display: flex; gap: 2rem; align-items: center; }
      .entry-date { color: #666; font-size: 0.9rem; font-weight: 400; }
      .journal-content { margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed #e2e0d8; color: #444; }
    </style>
  </body>
</html>